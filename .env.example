# Copy this file to .env and fill in what you need, then restart `npm run dev`.

# US proxy for directories that block your country (Yelp, BBB, some local directories).
# Use the HTTP proxy details from your proxy provider:
# PROXY_URL=http://username:password@us.proxy-provider.com:8080

# Only needed if Chrome is installed somewhere unusual:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
